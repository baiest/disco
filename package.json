{
  "name": "disco",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @disco/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "audit:high": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
