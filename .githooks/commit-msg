#!/usr/bin/env bash
# Rejects attribution trailers and non-ASCII text at commit time.
set -euo pipefail
msg_file="$1"

if grep -qiE '^(Co-Authored-By|Signed-off-by|Claude-Session|Generated with|Contributed by)' "$msg_file"; then
  echo "Attribution trailers are not allowed (AGENTS.md section 8)." >&2
  exit 1
fi
if LC_ALL=C grep -q '[^ -~]' "$msg_file"; then
  echo "Commit messages must be English ASCII (AGENTS.md section 8)." >&2
  exit 1
fi
